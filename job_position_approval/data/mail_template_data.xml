<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_job_approved" model="mail.template">
            <field name="name">Job Position: Approved</field>
            <field name="model_id" ref="hr_recruitment.model_hr_job"/>
            <field name="subject">Your Job Position "{{ object.name }}" has been Approved</field>
            <!-- <field name="email_to">{{ object.user_id.email or object.user_id.partner_id.email }}</field>
            <field name="partner_to">{{ object.user_id.partner_id.id }}</field> -->
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:Arial, sans-serif;font-size:14px;color:#454748;">
                    <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
                    <p>
                        Good news! The Job Position <strong t-out="object.name"/> has been
                        <strong style="color:#28a745;">Approved</strong> by
                        <t t-out="user.name"/> and is now published.
                    </p>
                    <p>Regards,<br/>Recruitment Team</p>
                </div>
            </field>
        </record>

        <record id="email_template_job_rejected" model="mail.template">
            <field name="name">Job Position: Rejected</field>
            <field name="model_id" ref="hr_recruitment.model_hr_job"/>
            <field name="subject">Your Job Position "{{ object.name }}" has been Rejected</field>
            <!-- <field name="email_to">{{ object.user_id.email or object.user_id.partner_id.email }}</field>
            <field name="partner_to">{{ object.user_id.partner_id.id }}</field> -->
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:Arial, sans-serif;font-size:14px;color:#454748;">
                    <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
                    <p>
                        The Job Position <strong t-out="object.name"/> has been
                        <strong style="color:#dc3545;">Rejected</strong> by
                        <t t-out="user.name"/> and has been reset to Draft.
                    </p>
                    <t t-if="object.rejection_reason">
                        <p><strong>Reason:</strong> <t t-out="object.rejection_reason"/></p>
                    </t>
                    <p>Please review the details, update as needed, and resubmit for approval.</p>
                    <p>Regards,<br/>Recruitment Team</p>
                </div>
            </field>
        </record>

    </data>
</odoo>
