<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        NEW: dedicated "Hiring Manager" group, separate from the stock
        Interviewer group. This is a genuinely new role, not a relabel -
        assign it to whichever users should be able to edit Budgeting
        Information / Roles & Responsibilities and view Version History
        on hr.job, without needing full Recruitment User/Manager access.

        Odoo 19 change: res.groups no longer has a direct category_id
        field. Group categories are now handled via an intermediate
        res.groups.privilege record instead - the privilege carries the
        category_id, and the group references the privilege via
        privilege_id. See https://www.odoo.com/documentation/19.0/developer/tutorials/restrict_data_access.html

        implied_ids: base.group_user means granting this group also
        grants basic "Internal User" access (required for the person to
        log in and see the Recruitment app menu at all). If you already
        grant these users group_hr_recruitment_user separately, this is
        redundant but harmless.
    -->
    <record id="privilege_hr_job_custom_hiring_manager" model="res.groups.privilege">
        <field name="name">Hiring Manager</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
    </record>

    <record id="group_hr_recruitment_hiring_manager" model="res.groups">
        <field name="name">Hiring Manager</field>
        <field name="privilege_id" ref="privilege_hr_job_custom_hiring_manager"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Custom role (Kavi HR Job Customization): can edit
            Budgeting Information / Roles &amp; Responsibilities on Job
            Positions and view their Version History, without needing full
            Recruitment User or Administrator access.</field>
    </record>

    <!--
        We rely on the existing hr_recruitment security groups:
          - hr_recruitment.group_hr_recruitment_interviewer  (Interviewer)
          - hr_recruitment.group_hr_recruitment_user         (Recruitment Officer/User)
          - hr_recruitment.group_hr_recruitment_manager      (Recruitment Administrator)
        plus the new group_hr_recruitment_hiring_manager defined above.

        Field/page visibility is controlled via the `groups` attribute on the
        fields (models/hr_job.py) and on the <page>/<field> tags in the views,
        for pages/fields this module itself adds.
        Job Boards & Vendors are restricted to User + Manager only (Interviewer
        and Hiring Manager excluded - unchanged from before).

        Exception: the "Offer Letter Components" page on hr.job is added by
        another, already-installed view/module (Studio/other), not by this
        module, so it has no <page> tag here to put `groups` on directly.
        That page (and everything on it) is instead hidden from Interviewer
        via HrJob.get_view() in models/hr_job.py, which strips the whole
        <page> node from the compiled arch by matching its tab label - see
        the docstring on that override for why a static XML `groups=`
        attribute isn't used there.
    -->

    <!-- Record rules: only Recruitment Access users can create/edit Job Boards -->
    <record id="rule_job_board_recruitment_only" model="ir.rule">
        <field name="name">Job Board: Recruitment Access Only</field>
        <field name="model_id" ref="model_hr_job_board"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user')),
                                     (4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <!-- Record rules: only Recruitment Access users can create/edit Vendors -->
    <record id="rule_vendor_recruitment_only" model="ir.rule">
        <field name="name">Vendor: Recruitment Access Only</field>
        <field name="model_id" ref="model_hr_recruitment_vendor"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user')),
                                     (4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <record id="rule_tracker_link_recruitment_only" model="ir.rule">
        <field name="name">Tracker Link: Recruitment Access Only</field>
        <field name="model_id" ref="model_hr_job_vendor_tracker_link"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user')),
                                     (4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>

    <!-- Applicant Resume Lines: Interviewers only see/edit resume lines
         belonging to applicants they're actually assigned to - same
         restriction pattern hr_recruitment_skills applies to
         hr.applicant.skill (hr_applicant_skill_interviewer_rule). -->
    <record id="rule_hr_applicant_resume_line_interviewer" model="ir.rule">
        <field name="name">Applicant Resume Line: Interviewer</field>
        <field name="model_id" ref="model_hr_applicant_resume_line"/>
        <field name="domain_force">[
            '|',
                ('applicant_id.job_id.interviewer_ids', 'in', user.id),
                ('applicant_id.interviewer_ids', 'in', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
    </record>

    <record id="rule_hr_applicant_resume_line_officer" model="ir.rule">
        <field name="name">Applicant Resume Line: Recruitment Access</field>
        <field name="model_id" ref="model_hr_applicant_resume_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user')),
                                     (4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
    </record>

    <!--
        Vendor Chatter privacy
        =======================
        The Chatter added to the Vendor form (views/vendor_views.xml) must
        only be usable by the two parties named on the Vendor record
        itself: the Recruiter (user_id) and the Vendor Contact
        (partner_id). Everyone else with access to Vendors in general
        (e.g. another Recruitment User who isn't the assigned Recruiter
        on this particular Vendor) must NOT be able to read or post in
        that conversation.

        This rule is deliberately GLOBAL (no <field name="groups">), so
        it is ANDed with every other mail.message rule for every user
        (regular internal users, portal users, etc.). It only tightens
        access for messages that belong to hr.recruitment.vendor records
        (model = 'hr.recruitment.vendor'); messages on every other model
        pass straight through untouched.
    -->
    <record id="rule_mail_message_vendor_chatter_private" model="ir.rule">
        <field name="name">Vendor Chatter: Private to Recruiter &amp; Vendor Contact</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="domain_force">['|',
            ('model', '!=', 'hr.recruitment.vendor'),
            ('res_id', 'in', user.env['hr.recruitment.vendor'].sudo().search([
                '|',
                ('user_id', '=', user.id),
                ('partner_id', '=', user.partner_id.id),
            ]).ids)]</field>
    </record>

    <!--
        Vendor Contact portal access
        =============================
        If/when the Vendor Contact (partner_id) is granted Portal access
        (Settings > Users > Grant Portal Access), this rule makes sure
        that portal user can only ever see the single Vendor record they
        are the contact for - never the full Vendor list.
    -->
    <record id="rule_vendor_portal_own_record_only" model="ir.rule">
        <field name="name">Vendor: Portal Contact Sees Only Their Own Vendor Record</field>
        <field name="model_id" ref="model_hr_recruitment_vendor"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">True</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <!-- Portal vendor access: a portal contact may read only jobs assigned to
         the vendor record for which that contact is the designated partner. -->
    <record id="rule_hr_job_portal_vendor_only" model="ir.rule">
        <field name="name">Job Position: Portal Vendor Sees Assigned Jobs Only</field>
        <field name="model_id" ref="hr_recruitment.model_hr_job"/>
        <field name="domain_force">[('vendor_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="rule_hr_job_vendor_tracker_link_portal_only" model="ir.rule">
        <field name="name">Vendor Tracker Link: Portal Vendor Sees Own Links Only</field>
        <field name="model_id" ref="model_hr_job_vendor_tracker_link"/>
        <field name="domain_force">[('vendor_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>
</odoo>
