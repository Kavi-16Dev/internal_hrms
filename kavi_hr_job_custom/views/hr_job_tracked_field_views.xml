<?xml version="1.0" encoding="utf-8"?>
<odoo>

    

    <record id="view_hr_job_tracked_field_list" model="ir.ui.view">
        <field name="name">hr.job.tracked.field.list</field>
        <field name="model">hr.job.tracked.field</field>
        <field name="arch" type="xml">
            <list string="Tracked Fields" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="field_key"/>
                <field name="field_label" string="Field Changed (label)"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_job_tracked_field_form" model="ir.ui.view">
        <field name="name">hr.job.tracked.field.form</field>
        <field name="model">hr.job.tracked.field</field>
        <field name="arch" type="xml">
            <form string="Tracked Field">
                <sheet>
                    <group>
                        <field name="field_key"/>
                        <field name="field_label" string="Field Changed (label)"/>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_job_tracked_field" model="ir.actions.act_window">
        <field name="name">Tracked Fields</field>
        <field name="res_model">hr.job.tracked.field</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Add "Budgeting Information" and/or "Key Roles and
                Responsibilities" here to have Version History track them.
            </p>
        </field>
    </record>

   

</odoo>
