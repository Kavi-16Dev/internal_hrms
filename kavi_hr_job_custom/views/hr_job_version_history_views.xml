<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kavi_job_version_history_list" model="ir.ui.view">
        <field name="name">hr.job.version.history.list</field>
        <field name="model">hr.job.version.history</field>
        <field name="arch" type="xml">
            <list string="Version History" create="false" edit="false"
                  delete="false" default_order="changed_on desc">
                <field name="job_id" string="Job Position" optional="show"/>
                <field name="changed_on" string="Date &amp; Time"/>
                <field name="changed_by" string="Changed By"/>
                <field name="field_label" string="Field Changed"/>
                <field name="old_value_text" string="Previous Value"/>
                <field name="new_value_text" string="New Value"/>
                <button name="action_view_version_history_detail" type="object"
                        string="View Version History" class="btn-link"
                        icon="fa-history"/>
            </list>
        </field>
    </record>

   
    <record id="view_kavi_job_version_history_form" model="ir.ui.view">
        <field name="name">hr.job.version.history.form</field>
        <field name="model">hr.job.version.history</field>
        <field name="arch" type="xml">
            <form string="Version Detail" create="false" delete="false">
                <sheet>
                    <div class="d-flex justify-content-end mb-3">
                        <button name="action_back_to_version_history_list" type="object"
                                string="View Version History" class="btn-secondary"
                                icon="fa-history"/>
                    </div>
                    <group>
                        <field name="field_changed_picker" string="Field Changed"/>
                        <field name="changed_on" string="Changed On" readonly="1"/>
                        <field name="changed_by" string="Changed By" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Previous Value">
                            <field name="old_value" readonly="1" nolabel="1"/>
                        </page>
                        <page string="New Value">
                            <field name="new_value" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                    <div class="mt-3">
                        <button name="action_discard_version_history_detail" type="object"
                                string="Discard" class="btn-secondary"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
   
    <record id="action_hr_job_version_history_all" model="ir.actions.act_window">
        <field name="name">Version History</field>
        <field name="res_model">hr.job.version.history</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                No tracked changes have been saved yet for any Job Position.
                Edit Budgeting Information or Key Roles and Responsibilities
                on a Job Position and save it to create the first entry.
            </p>
        </field>
    </record>

    <record id="action_hr_job_version_history_all_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_kavi_job_version_history_list"/>
        <field name="act_window_id" ref="action_hr_job_version_history_all"/>
    </record>

    <record id="action_hr_job_version_history_all_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_kavi_job_version_history_form"/>
        <field name="act_window_id" ref="action_hr_job_version_history_all"/>
    </record>

   

</odoo>
