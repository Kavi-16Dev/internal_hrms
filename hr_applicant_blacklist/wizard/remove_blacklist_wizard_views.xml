<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_remove_blacklist_wizard_form" model="ir.ui.view">
        <field name="name">hr.applicant.remove.blacklist.wizard.form</field>
        <field name="model">hr.applicant.remove.blacklist.wizard</field>
        <field name="arch" type="xml">
            <form string="Remove Blacklist">
                <group>
                    <field name="applicant_id" invisible="1"/>
                    <field name="reason" placeholder="Why is the blacklist being removed?"/>
                </group>
                <footer>
                    <button string="Save" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
