<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_documents_purge_trash" model="ir.cron">
            <field name="name">Documents: Permanently delete expired Trash items</field>
            <field name="model_id" ref="model_documents_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_trash()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    
    <record id="ir_cron_rebuild_shared_user_index" model="ir.cron">
        <field name="name">Documents: Rebuild Shared with me Index</field>
        <field name="model_id" ref="model_documents_share"/>
        <field name="state">code</field>
        <field name="code">model.rebuild_shared_user_index()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</data>
</odoo>
