<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="custom_documents.LinkDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_link_dialog">
                <div class="mb-3">
                    <label class="form-label" for="documents_link_name">Name</label>
                    <input id="documents_link_name" type="text" class="form-control"
                           t-model="state.name" placeholder="e.g. Project Specification"
                           autofocus=""/>
                </div>
                <div class="mb-1">
                    <label class="form-label" for="documents_link_url">Link</label>
                    <input id="documents_link_url" type="text" class="form-control"
                           t-model="state.url" placeholder="https://..."/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    Save
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.NewFolderDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_new_folder_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_new_folder_name">Folder Name</label>
                    <input id="documents_new_folder_name" type="text" class="form-control"
                           t-model="state.name" placeholder="e.g. Contracts"
                           autofocus=""
                           t-on-keydown="onNameKeydown"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    Create
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.RenameDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_rename_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_rename_name">Name</label>
                    <input id="documents_rename_name" type="text" class="form-control"
                           t-model="state.name" autofocus="" select=""
                           t-on-keydown="onNameKeydown"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    Save
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.MoveDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_move_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_move_folder">Destination Workspace</label>
                    <select id="documents_move_folder" class="form-select"
                            t-on-change="(ev) => this.state.folderId = parseInt(ev.target.value) || false">
                        <option value="">-- Select a workspace --</option>
                        <t t-foreach="state.folders" t-as="folder" t-key="folder.id">
                            <option t-att-value="folder.id" t-esc="folder.display_name"/>
                        </t>
                    </select>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    <t t-esc="confirmLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.VersionsDialog">
        <Dialog title="title" size="'lg'">
            <div class="o_documents_versions_dialog">
                <div t-if="state.isLoading" class="text-muted p-3">Loading...</div>
                <div t-elif="!state.versions.length" class="text-muted p-3">
                    No previous versions yet. A version is saved automatically every time
                    this file is replaced.
                </div>
                <table t-else="" class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>File</th>
                            <th>Date</th>
                            <th>By</th>
                            <th>Size</th>
                            <th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.versions" t-as="version" t-key="version.id">
                            <td t-esc="version.name"/>
                            <td t-esc="version.dateLabel"/>
                            <td t-esc="version.userName"/>
                            <td t-esc="formatSize(version.file_size)"/>
                            <td class="text-end">
                                <a t-if="version.downloadUrl" t-att-href="version.downloadUrl"
                                   class="btn btn-sm btn-link" title="Download">
                                    <i class="fa fa-download"/>
                                </a>
                                <button class="btn btn-sm btn-link"
                                        t-on-click="() => this.onRestore(version.id)">
                                    Restore
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="onClose">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.SplitPdfDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_split_pdf_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_split_ranges">Page Ranges</label>
                    <input id="documents_split_ranges" type="text" class="form-control"
                           t-model="state.ranges" placeholder="e.g. 1-2,3,4-5" autofocus=""/>
                    <div class="form-text">
                        Each range becomes a new document in the same workspace (comma-separated,
                        e.g. "1-2,3,4-5"). The original file is not modified.
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    Split
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>


    <t t-name="custom_documents.ShareDialog">
        <Dialog title="title" size="'lg'">
            <div class="o_documents_share_dialog">
                <t t-if="state.loading">
                    <div class="d-flex justify-content-center align-items-center py-5 text-muted">
                        <i class="fa fa-spinner fa-spin me-2"/>Loading…
                    </div>
                </t>
                <t t-else="">
                    <!-- Add People / Add Groups -->
                    <div class="o_documents_share_target d-flex gap-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="documents_share_target_people"
                                   name="documents_share_target"
                                   t-att-checked="state.target === 'people'"
                                   t-on-change="() => this.onTargetChange('people')"/>
                            <label class="form-check-label" for="documents_share_target_people">Add People</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="documents_share_target_groups"
                                   name="documents_share_target"
                                   t-att-checked="state.target === 'groups'"
                                   t-on-change="() => this.onTargetChange('groups')"/>
                            <label class="form-check-label" for="documents_share_target_groups">Add Groups</label>
                        </div>
                    </div>

                    <div class="o_documents_share_people_picker">
                        <div class="o_documents_share_people_icon">
                            <i class="fa fa-user-plus"/>
                        </div>
                        <div class="o_documents_share_people_field">
                            <div t-if="hasSelection" class="o_documents_share_chips">
                                <span t-foreach="state.selectedUsers" t-as="person" t-key="'u' + person.id"
                                      class="o_documents_share_chip">
                                    <span t-esc="person.name"/>
                                    <button type="button" class="btn btn-link p-0 ms-1"
                                            t-on-click="() => this.removeUser(person.id)"
                                            aria-label="Remove">
                                        <i class="fa fa-times"/>
                                    </button>
                                </span>
                                <span t-foreach="state.selectedGroups" t-as="group" t-key="'g' + group.id"
                                      class="o_documents_share_chip">
                                    <i class="fa fa-users me-1"/>
                                    <span t-esc="group.name"/>
                                    <button type="button" class="btn btn-link p-0 ms-1"
                                            t-on-click="() => this.removeGroup(group.id)"
                                            aria-label="Remove">
                                        <i class="fa fa-times"/>
                                    </button>
                                </span>
                            </div>
                            <input type="text"
                                   class="o_documents_share_people_input"
                                   t-att-placeholder="state.target === 'groups' ? 'Add groups' : 'Add people or email addresses'"
                                   t-model="state.search"
                                   t-on-input="onSearchInput"
                                   t-on-focus="onFocusSearch"
                                   t-on-blur="onBlurSearch"
                                   autocomplete="off"/>
                            <div t-if="state.showSuggestions and state.suggestions.length"
                                 class="o_documents_share_suggestions">
                                <t t-foreach="state.suggestions" t-as="item" t-key="item.id">
                                    <button type="button"
                                            class="o_documents_share_suggestion"
                                            t-on-mousedown="() => this.addSuggestion(item)">
                                        <span class="o_documents_share_avatar">
                                            <i t-if="state.target === 'groups'" class="fa fa-users"/>
                                            <t t-else="" t-esc="item.name.slice(0, 1).toUpperCase()"/>
                                        </span>
                                        <span class="d-flex flex-column text-start">
                                            <strong t-esc="item.name"/>
                                            <small t-if="state.target === 'groups'" class="text-muted">
                                                <t t-esc="item.user_count"/> internal user(s)
                                            </small>
                                            <small t-else="" class="text-muted" t-esc="item.email"/>
                                        </span>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Role / notify / message: only once somebody is selected. -->
                    <div t-if="hasSelection" class="o_documents_share_controls">
                        <div class="o_documents_share_row">
                            <div class="o_documents_share_label">Role <span class="text-info">?</span></div>
                            <select class="form-select form-select-sm o_documents_share_select"
                                    t-on-change="onRoleChange">
                                <option value="viewer" t-att-selected="state.role === 'viewer'">Viewer</option>
                                <option value="editor" t-att-selected="state.role === 'editor'">Editor</option>
                            </select>
                        </div>
                        <div class="o_documents_share_row">
                            <div class="o_documents_share_label">Notify <span class="text-info">?</span></div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox"
                                       t-model="state.notify" id="documents_share_notify"/>
                            </div>
                        </div>
                        <textarea class="form-control o_documents_share_message"
                                  placeholder="Extra comments..."
                                  rows="2"
                                  t-model="state.message"/>
                        <button type="button"
                                class="btn btn-outline-secondary o_documents_share_link_chip"
                                t-on-click="onCopyLink"
                                t-att-title="state.shareUrl">
                            <i class="fa fa-file-o me-2"/>
                            <span t-esc="state.documentName"/>
                        </button>
                    </div>

                    <!-- People with access (owner first). -->
                    <div t-if="!hasSelection" class="o_documents_share_access_list">
                        <div t-if="state.owner" class="o_documents_share_access_person">
                            <span class="o_documents_share_avatar">
                                <t t-esc="state.owner.name.slice(0, 1).toUpperCase()"/>
                            </span>
                            <span class="d-flex flex-column flex-grow-1">
                                <span>
                                    <strong t-esc="state.owner.name"/>
                                    <span t-if="state.owner.is_current_user" class="o_documents_share_you_badge">You</span>
                                </span>
                                <small class="text-muted" t-esc="state.owner.email"/>
                            </span>
                            <span class="text-muted">Owner</span>
                        </div>
                        <div t-foreach="state.users" t-as="person" t-key="person.id"
                             class="o_documents_share_access_person">
                            <span class="o_documents_share_avatar o_documents_share_avatar_recipient">
                                <t t-esc="person.name.slice(0, 1).toUpperCase()"/>
                            </span>
                            <span class="d-flex flex-column flex-grow-1">
                                <strong t-esc="person.name"/>
                                <small class="text-muted" t-esc="person.email"/>
                            </span>
                            <span class="text-muted">
                                <t t-if="person.role === 'editor'">Editor</t>
                                <t t-else="">Viewer</t>
                            </span>
                        </div>
                    </div>

                    <!-- General Access: always visible, saved on change. -->
                    <div t-if="!hasSelection" class="o_documents_share_section">
                        <h5 class="mb-3">General Access</h5>
                        <div class="o_documents_share_general_row">
                            <div>
                                <div class="fw-semibold">Internal users <span class="text-info" title="Access for every internal user of the database">?</span></div>
                                <div class="text-muted small" t-esc="internalHint"/>
                            </div>
                            <select class="form-select form-select-sm o_documents_share_select"
                                    t-att-disabled="!state.canManageAccess"
                                    t-on-change="(ev) => this.onGeneralAccessChange('internal', ev)">
                                <option value="viewer" t-att-selected="state.generalInternal === 'viewer'">Viewer</option>
                                <option value="editor" t-att-selected="state.generalInternal === 'editor'">Editor</option>
                                <option value="none" t-att-selected="state.generalInternal === 'none'">None</option>
                            </select>
                        </div>
                        <div class="o_documents_share_access_link mt-3">
                            <div>
                                <div class="fw-semibold">Access through link <span class="text-info" title="Whether anyone holding the link can open the document">?</span></div>
                                <div class="text-muted small" t-esc="linkHint"/>
                            </div>
                            <select class="form-select form-select-sm o_documents_share_select"
                                    t-att-disabled="!state.canManageAccess"
                                    t-on-change="(ev) => this.onGeneralAccessChange('link', ev)">
                                <option value="viewer" t-att-selected="state.generalLink === 'viewer'">Viewer</option>
                                <option value="editor" t-att-selected="state.generalLink === 'editor'">Editor</option>
                                <option value="none" t-att-selected="state.generalLink === 'none'">None</option>
                            </select>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <t t-if="hasSelection">
                    <button type="button" class="btn btn-primary"
                            t-att-disabled="!canShare"
                            t-on-click="onShare">
                        Share
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onCopyLink">
                        <i class="fa fa-copy me-1"/>Copy Links
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                        Discard
                    </button>
                </t>
                <t t-else="">
                    <button type="button" class="btn btn-primary" t-on-click="onDiscard">
                        Done
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onCopyLink">
                        <i class="fa fa-copy me-1"/>Copy Link
                    </button>
                </t>
            </t>
        </Dialog>
    </t>

</templates>

