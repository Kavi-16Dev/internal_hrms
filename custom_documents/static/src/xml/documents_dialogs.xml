<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="custom_documents.LinkDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_link_dialog">
                <div class="mb-3">
                    <label class="form-label" for="documents_link_name">Name</label>
                    <input id="documents_link_name" type="text" class="form-control"
                           t-model="state.name" placeholder="e.g. Project Specification"
                           autofocus=""/>
                </div>
                <div class="mb-1">
                    <label class="form-label" for="documents_link_url">Link</label>
                    <input id="documents_link_url" type="text" class="form-control"
                           t-model="state.url" placeholder="https://..."/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    Save
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.NewFolderDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_new_folder_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_new_folder_name"><t t-esc="nameLabel"/></label>
                    <input id="documents_new_folder_name" type="text" class="form-control"
                           t-model="state.name" placeholder="e.g. Contracts"
                           autofocus=""
                           t-on-keydown="onNameKeydown"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    <t t-esc="confirmLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.RenameDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_rename_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_rename_name">Name</label>
                    <input id="documents_rename_name" type="text" class="form-control"
                           t-model="state.name" autofocus="" select=""
                           t-on-keydown="onNameKeydown"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    Save
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.ShortcutDialog">
        <Dialog title="title" size="'lg'">
            <div class="o_documents_shortcut_dialog">
                <h5 class="mb-3">Choose a destination</h5>
                <div class="input-group mb-2 o_documents_shortcut_search">
                    <input type="text" class="form-control" placeholder="Search..."
                           t-model="state.search"/>
                    <button type="button" class="btn btn-outline-secondary"
                            title="Clear" t-on-click="clearSearch">
                        <i class="fa fa-eraser"/>
                    </button>
                </div>
                <div class="o_documents_shortcut_tree">
                    <t t-foreach="visibleTree" t-as="node" t-key="node.id">
                        <t t-call="custom_documents.ShortcutTreeNode">
                            <t t-set="depth" t-value="0"/>
                        </t>
                    </t>
                    <div t-if="!visibleTree.length" class="text-muted p-2">No matching folder.</div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isActionDisabled"
                        t-on-click="onConfirm">
                    <t t-esc="confirmLabel"/>
                </button>
                <button type="button" class="btn btn-secondary"
                        t-att-disabled="isActionDisabled"
                        t-on-click="onCreateFolder">
                    <t t-esc="createFolderLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.MoveConfirmDialog">
        <Dialog title="title" size="'md'">
            <div class="o_documents_move_confirm">
                <div t-if="state.loading" class="text-muted">Loading...</div>
                <t t-else="">
                    <p class="text-warning mb-3">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        Moving the document(s) will change their access rights to the following settings:
                    </p>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Internal Users</span>
                        <span t-esc="internalRight.label"/>
                    </div>
                    <div class="text-muted mb-3" t-esc="internalRight.help"/>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Anyone with the link</span>
                        <span t-esc="linkRight.label"/>
                    </div>
                    <div class="text-muted mb-2" t-esc="linkRight.help"/>
                </t>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="state.loading or state.isSaving"
                        t-on-click="onMove">
                    Move
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.ShortcutTreeNode">
        <t t-set="children" t-value="visibleChildren(node)"/>
        <div class="o_documents_shortcut_row d-flex align-items-center rounded"
             t-att-class="{'active': state.selectedId === node.id}"
             t-attf-style="padding-left: #{depth * 1.2}rem;">
            <button t-if="children.length" type="button"
                    class="btn btn-link btn-sm p-0 o_documents_shortcut_caret"
                    t-on-click.stop="() => this.toggle(node)">
                <i t-attf-class="fa {{ isExpanded(node) ? 'fa-caret-down' : 'fa-caret-right' }}"/>
            </button>
            <span t-else="" class="o_documents_shortcut_caret"/>
            <a href="#" class="flex-grow-1 text-truncate text-decoration-none py-1 o_documents_shortcut_link"
               t-on-click.prevent="() => this.select(node)">
                <i t-attf-class="fa {{ depth === 0 ? 'fa-folder' : 'fa-folder-o' }} me-1"/><t t-esc="node.name"/>
            </a>
        </div>
        <t t-if="children.length and isExpanded(node)">
            <t t-foreach="children" t-as="child" t-key="child.id">
                <t t-call="custom_documents.ShortcutTreeNode">
                    <t t-set="node" t-value="child"/>
                    <t t-set="depth" t-value="depth + 1"/>
                </t>
            </t>
        </t>
    </t>

    <t t-name="custom_documents.MoveDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_move_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_move_folder">Destination Workspace</label>
                    <select id="documents_move_folder" class="form-select"
                            t-on-change="(ev) => this.state.folderId = parseInt(ev.target.value) || false">
                        <option value="">-- Select a workspace --</option>
                        <t t-foreach="state.folders" t-as="folder" t-key="folder.id">
                            <option t-att-value="folder.id" t-esc="folder.display_name"/>
                        </t>
                    </select>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    <t t-esc="confirmLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.InfoDialog">
        <Dialog title="title" size="'md'">
            <div class="o_documents_info_dialog">
                <div t-if="state.loading" class="text-muted">Loading...</div>
                <t t-else="">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Name</label>
                        <input type="text" class="form-control" t-att-value="state.info.name"
                               t-on-change="onNameChange"/>
                    </div>
                    <t t-if="isFolder">
                        <div class="mb-2 small">
                            <span class="text-muted">Parent workspace: </span>
                            <span t-esc="state.info.parent_folder_id ? state.info.parent_folder_id[1] : '—'"/>
                        </div>
                        <div class="mb-2 small">
                            <span class="text-muted">Documents: </span>
                            <span t-esc="state.info.document_count"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="mb-3">
                            <label class="form-label small text-muted d-block">Tags</label>
                            <span t-foreach="state.info.allTags" t-as="tag" t-key="tag.id"
                                  class="badge me-1 mb-1 o_documents_info_tag"
                                  t-att-class="{'o_documents_info_tag_selected': isTagSelected(tag.id)}"
                                  t-on-click="() => this.onToggleTag(tag.id)"
                                  t-esc="tag.name"/>
                            <div t-if="!state.info.allTags.length" class="text-muted small">No tags configured.</div>
                        </div>
                        <div class="mb-2 small">
                            <span class="text-muted">Owner: </span>
                            <span t-esc="state.info.owner_id ? state.info.owner_id[1] : '—'"/>
                        </div>
                        <div class="mb-2 small">
                            <span class="text-muted">Workspace: </span>
                            <span t-esc="state.info.folder_id ? state.info.folder_id[1] : '—'"/>
                        </div>
                        <div class="mb-2 small" t-if="state.info.partner_id">
                            <span class="text-muted">Contact: </span>
                            <span t-esc="state.info.partner_id[1]"/>
                        </div>
                        <div class="mb-2 small" t-if="state.info.res_name">
                            <span class="text-muted">Related Record: </span>
                            <span t-esc="state.info.res_name"/>
                        </div>
                        <div class="mb-2 small">
                            <span class="text-muted">Size: </span>
                            <span t-esc="formatFileSize(state.info.file_size)"/>
                        </div>
                        <div class="mb-2 small" t-if="state.info.lock_uid">
                            <span class="text-muted">Locked by: </span>
                            <span t-esc="state.info.lock_uid[1]"/>
                        </div>
                    </t>
                </t>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="onClose">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.VersionsDialog">
        <Dialog title="dialogTitle" size="'lg'">
            <div class="o_documents_versions_dialog">
                <div t-if="state.isLoading" class="text-muted p-3">Loading...</div>
                <t t-else="">
                    <button type="button" class="btn btn-secondary mb-3"
                            t-att-disabled="state.isBusy"
                            t-on-click="onUploadClick">
                        Upload New Version
                    </button>
                    <input type="file" class="d-none" t-ref="fileInput" t-on-change="onFileChosen"/>

                    <!-- Current version -->
                    <div t-if="state.current" class="o_documents_version_row o_documents_version_current border-top py-3">
                        <div class="d-flex align-items-start">
                            <div class="flex-grow-1 text-break">
                                <i t-attf-class="fa {{ state.current.icon }} me-2"/>
                                <span class="text-muted">Current Version</span>
                                <span class="ms-1" t-esc="state.current.name"/>
                                <div class="small">
                                    <b t-esc="state.current.dateLabel"/>
                                    <span class="ms-1" t-esc="state.current.user"/>
                                    <span class="ms-2 text-muted" t-esc="formatSize(state.current.file_size)"/>
                                </div>
                            </div>
                            <div class="d-flex gap-1 ms-3 flex-shrink-0">
                                <a t-att-href="state.current.downloadUrl" class="btn btn-sm btn-secondary">
                                    <i class="fa fa-download me-1"/>Download
                                </a>
                                <button t-if="state.current.can_delete" type="button"
                                        class="btn btn-sm btn-secondary"
                                        t-att-disabled="state.isBusy"
                                        t-on-click="onDeleteCurrent">
                                    <i class="fa fa-trash me-1"/>Delete
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Previous versions -->
                    <div t-foreach="state.versions" t-as="version" t-key="version.id"
                         class="o_documents_version_row border-top py-3">
                        <div class="d-flex align-items-start">
                            <div class="flex-grow-1 text-break">
                                <i t-attf-class="fa {{ version.icon }} me-2"/>
                                <span t-esc="version.name"/>
                                <div class="small">
                                    <b t-esc="version.dateLabel"/>
                                    <span class="ms-1" t-esc="version.user"/>
                                    <span class="ms-2 text-muted" t-esc="formatSize(version.file_size)"/>
                                </div>
                            </div>
                            <div class="d-flex gap-1 ms-3 flex-shrink-0">
                                <a t-att-href="version.downloadUrl" class="btn btn-sm btn-secondary">
                                    <i class="fa fa-download me-1"/>Download
                                </a>
                                <button type="button" class="btn btn-sm btn-secondary"
                                        t-att-disabled="state.isBusy"
                                        t-on-click="() => this.onRestore(version.id)">
                                    <i class="fa fa-undo me-1"/>Restore
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary"
                                        t-att-disabled="state.isBusy"
                                        t-on-click="() => this.onDeleteVersion(version.id)">
                                    <i class="fa fa-trash me-1"/>Delete
                                </button>
                            </div>
                        </div>
                    </div>
                    <div t-if="!state.versions.length" class="border-top pt-3 text-muted small">
                        No previous versions yet. A version is saved automatically every time
                        this file is replaced.
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="onClose">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

    <t t-name="custom_documents.SplitPdfDialog">
        <Dialog title="title" size="'sm'">
            <div class="o_documents_split_pdf_dialog">
                <div class="mb-1">
                    <label class="form-label" for="documents_split_ranges">Page Ranges</label>
                    <input id="documents_split_ranges" type="text" class="form-control"
                           t-model="state.ranges" placeholder="e.g. 1-2,3,4-5" autofocus=""/>
                    <div class="form-text">
                        Each range becomes a new document in the same workspace (comma-separated,
                        e.g. "1-2,3,4-5"). The original file is not modified.
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                        t-att-disabled="isConfirmDisabled"
                        t-on-click="onConfirm">
                    Split
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>


    <t t-name="custom_documents.ShareDialog">
        <Dialog title="title" size="'lg'">
            <div class="o_documents_share_dialog">
                <t t-if="state.loading">
                    <div class="d-flex justify-content-center align-items-center py-5 text-muted">
                        <i class="fa fa-spinner fa-spin me-2"/>Loading…
                    </div>
                </t>
                <t t-else="">
                    <!-- Add People / Add Groups -->
                    <div t-if="!isFolder or state.canManageAccess"
                         class="o_documents_share_target d-flex gap-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="documents_share_target_people"
                                   name="documents_share_target"
                                   t-att-checked="state.target === 'people'"
                                   t-on-change="() => this.onTargetChange('people')"/>
                            <label class="form-check-label" for="documents_share_target_people">Add People</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="documents_share_target_groups"
                                   name="documents_share_target"
                                   t-att-checked="state.target === 'groups'"
                                   t-on-change="() => this.onTargetChange('groups')"/>
                            <label class="form-check-label" for="documents_share_target_groups">Add Groups</label>
                        </div>
                    </div>

                    <div t-if="!isFolder or state.canManageAccess"
                         class="o_documents_share_people_picker">
                        <div class="o_documents_share_people_icon">
                            <i class="fa fa-user-plus"/>
                        </div>
                        <div class="o_documents_share_people_field">
                            <div t-if="hasSelection" class="o_documents_share_chips">
                                <span t-foreach="state.selectedUsers" t-as="person" t-key="'u' + person.id"
                                      class="o_documents_share_chip">
                                    <span t-esc="person.name"/>
                                    <button type="button" class="btn btn-link p-0 ms-1"
                                            t-on-click="() => this.removeUser(person.id)"
                                            aria-label="Remove">
                                        <i class="fa fa-times"/>
                                    </button>
                                </span>
                                <span t-foreach="state.selectedGroups" t-as="group" t-key="'g' + group.id"
                                      class="o_documents_share_chip">
                                    <i class="fa fa-users me-1"/>
                                    <span t-esc="group.name"/>
                                    <button type="button" class="btn btn-link p-0 ms-1"
                                            t-on-click="() => this.removeGroup(group.id)"
                                            aria-label="Remove">
                                        <i class="fa fa-times"/>
                                    </button>
                                </span>
                            </div>
                            <input type="text"
                                   class="o_documents_share_people_input"
                                   t-att-placeholder="state.target === 'groups' ? 'Add groups' : 'Add people or email addresses'"
                                   t-model="state.search"
                                   t-on-input="onSearchInput"
                                   t-on-focus="onFocusSearch"
                                   t-on-blur="onBlurSearch"
                                   autocomplete="off"/>
                            <div t-if="state.showSuggestions and state.suggestions.length"
                                 class="o_documents_share_suggestions">
                                <t t-foreach="state.suggestions" t-as="item" t-key="item.id">
                                    <button type="button"
                                            class="o_documents_share_suggestion"
                                            t-on-mousedown="() => this.addSuggestion(item)">
                                        <span class="o_documents_share_avatar">
                                            <i t-if="state.target === 'groups'" class="fa fa-users"/>
                                            <t t-else="" t-esc="item.name.slice(0, 1).toUpperCase()"/>
                                        </span>
                                        <span class="d-flex flex-column text-start">
                                            <strong t-esc="item.name"/>
                                            <small t-if="state.target === 'groups'" class="text-muted">
                                                <t t-esc="item.user_count"/> internal user(s)
                                            </small>
                                            <small t-else="" class="text-muted" t-esc="item.email"/>
                                        </span>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Role / notify / message: only once somebody is selected. -->
                    <div t-if="hasSelection" class="o_documents_share_controls">
                        <div class="o_documents_share_row">
                            <div class="o_documents_share_label">Role <span class="text-info">?</span></div>
                            <select class="form-select form-select-sm o_documents_share_select"
                                    t-on-change="onRoleChange">
                                <option value="viewer" t-att-selected="state.role === 'viewer'">Viewer</option>
                                <option value="editor" t-att-selected="state.role === 'editor'">Editor</option>
                            </select>
                        </div>
                        <div class="o_documents_share_row">
                            <div class="o_documents_share_label">Notify <span class="text-info">?</span></div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox"
                                       t-model="state.notify" id="documents_share_notify"/>
                            </div>
                        </div>
                        <textarea class="form-control o_documents_share_message"
                                  placeholder="Extra comments..."
                                  rows="2"
                                  t-model="state.message"/>
                        <button type="button"
                                class="btn btn-outline-secondary o_documents_share_link_chip"
                                t-on-click="onCopyLink"
                                t-att-title="state.shareUrl">
                            <i t-attf-class="fa {{ isFolder ? 'fa-folder-o' : 'fa-file-o' }} me-2"/>
                            <span t-esc="state.documentName"/>
                        </button>
                    </div>

                    <!-- People with access (owner first). -->
                    <div t-if="!hasSelection" class="o_documents_share_access_list">
                        <div t-if="state.owner" class="o_documents_share_access_person">
                            <span class="o_documents_share_avatar">
                                <t t-esc="state.owner.name.slice(0, 1).toUpperCase()"/>
                            </span>
                            <span class="d-flex flex-column flex-grow-1">
                                <span>
                                    <strong t-esc="state.owner.name"/>
                                    <span t-if="state.owner.is_current_user" class="o_documents_share_you_badge">You</span>
                                </span>
                                <small class="text-muted" t-esc="state.owner.email"/>
                            </span>
                            <span class="text-muted">Owner</span>
                        </div>
                        <div t-foreach="state.users" t-as="person" t-key="person.id"
                             class="o_documents_share_access_person">
                            <span class="o_documents_share_avatar o_documents_share_avatar_recipient">
                                <t t-esc="person.name.slice(0, 1).toUpperCase()"/>
                            </span>
                            <span class="d-flex flex-column flex-grow-1">
                                <strong t-esc="person.name"/>
                                <small class="text-muted" t-esc="person.email"/>
                            </span>
                            <span class="text-muted">
                                <t t-if="person.role === 'editor'">Editor</t>
                                <t t-else="">Viewer</t>
                            </span>
                            <button t-if="isFolder and state.canManageAccess" type="button"
                                    class="btn btn-link text-muted p-0 ms-3 o_documents_share_remove_access"
                                    title="Remove access"
                                    t-on-click="() => this.onRemoveAccess(person)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <!-- Folders only: people who already have access through
                             a share on one of the parent folders. -->
                        <div t-foreach="state.inheritedUsers" t-as="person" t-key="'i' + person.id"
                             class="o_documents_share_access_person">
                            <span class="o_documents_share_avatar o_documents_share_avatar_recipient">
                                <t t-esc="person.name.slice(0, 1).toUpperCase()"/>
                            </span>
                            <span class="d-flex flex-column flex-grow-1">
                                <strong t-esc="person.name"/>
                                <small class="text-muted" t-esc="person.email"/>
                            </span>
                            <span class="text-muted text-end">
                                <t t-if="person.role === 'editor'">Editor</t>
                                <t t-else="">Viewer</t>
                                <small t-if="person.inherited_from" class="d-block">
                                    Inherited from <t t-esc="person.inherited_from"/>
                                </small>
                            </span>
                        </div>
                    </div>

                    <!-- General Access: always visible, saved on change. -->
                    <div t-if="!hasSelection" class="o_documents_share_section">
                        <h5 class="mb-3">General Access</h5>
                        <div class="o_documents_share_general_row">
                            <div>
                                <div class="fw-semibold">Internal users <span class="text-info" title="Access for every internal user of the database">?</span></div>
                                <div class="text-muted small" t-esc="internalHint"/>
                                <div t-if="inheritedInternalHint" class="text-muted small fst-italic"
                                     t-esc="inheritedInternalHint"/>
                            </div>
                            <select class="form-select form-select-sm o_documents_share_select"
                                    t-att-disabled="!state.canManageAccess"
                                    t-on-change="(ev) => this.onGeneralAccessChange('internal', ev)">
                                <option value="viewer" t-att-selected="state.generalInternal === 'viewer'">Viewer</option>
                                <option value="editor" t-att-selected="state.generalInternal === 'editor'">Editor</option>
                                <option value="none" t-att-selected="state.generalInternal === 'none'">None</option>
                            </select>
                        </div>
                        <div class="o_documents_share_access_link mt-3">
                            <div>
                                <div class="fw-semibold">Access through link <span class="text-info" title="Whether anyone holding the link can open the document">?</span></div>
                                <div class="text-muted small" t-esc="linkHint"/>
                            </div>
                            <select class="form-select form-select-sm o_documents_share_select"
                                    t-att-disabled="!state.canManageAccess"
                                    t-on-change="(ev) => this.onGeneralAccessChange('link', ev)">
                                <option value="viewer" t-att-selected="state.generalLink === 'viewer'">Viewer</option>
                                <option value="editor" t-att-selected="state.generalLink === 'editor'">Editor</option>
                                <option value="none" t-att-selected="state.generalLink === 'none'">None</option>
                            </select>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <t t-if="hasSelection">
                    <button type="button" class="btn btn-primary"
                            t-att-disabled="!canShare"
                            t-on-click="onShare">
                        Share
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onCopyLink">
                        <i class="fa fa-copy me-1"/>Copy Links
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                        Discard
                    </button>
                </t>
                <t t-else="">
                    <button type="button" class="btn btn-primary" t-on-click="onDiscard">
                        Done
                    </button>
                    <button type="button" class="btn btn-secondary" t-on-click="onCopyLink">
                        <i class="fa fa-copy me-1"/>Copy Link
                    </button>
                </t>
            </t>
        </Dialog>
    </t>

</templates>

