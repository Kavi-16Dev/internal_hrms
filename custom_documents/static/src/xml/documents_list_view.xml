<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="custom_documents.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button">
                <t t-if="props.showButtons" t-call="custom_documents.NewButtonDropdown"/>
            </t>
        </xpath>
        <!-- "N selected" must count selected folders too. -->
        <xpath expr="//SelectionBox" position="replace">
            <DocumentsSelectionBox root="this.model.root"/>
        </xpath>
        <!-- Download | Share next to the Actions menu. -->
        <xpath expr="//t[@t-set-slot='control-panel-selection-actions']//t[@t-if='!env.isSmall']" position="inside">
            <t t-call="custom_documents.SelectionActions"/>
        </xpath>
    </t>

</templates>
