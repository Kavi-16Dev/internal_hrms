<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="documents_group_view_list" model="ir.ui.view">
        <field name="name">documents.group.list</field>
        <field name="model">documents.group</field>
        <field name="arch" type="xml">
            <list string="Groups">
                <field name="name"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="documents_group_view_form" model="ir.ui.view">
        <field name="name">documents.group.form</field>
        <field name="model">documents.group</field>
        <field name="arch" type="xml">
            <form string="Group">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. HR Group"
                               class="fs-2"/>
                        <field name="responsible_ids" widget="many2many_avatar_user"/>
                        <field name="user_ids" widget="many2many_avatar_user"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="documents_group_view_search" model="ir.ui.view">
        <field name="name">documents.group.search</field>
        <field name="model">documents.group</field>
        <field name="arch" type="xml">
            <search string="Groups">
                <field name="name"/>
                <field name="user_ids"/>
                <field name="responsible_ids"/>
            </search>
        </field>
    </record>

    <record id="documents_group_action" model="ir.actions.act_window">
        <field name="name">Group</field>
        <field name="res_model">documents.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a group</p>
            <p>Groups gather users, with one or more responsibles to manage them.</p>
        </field>
    </record>

</odoo>
