<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds a "Documents" smart button on the Employee form, opening the
         employee's dedicated subfolder inside the company's configured
         Employees Folder (Settings > Documents > Files Centralization). -->
    <record id="hr_employee_view_form_inherit_documents" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.custom.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        groups="custom_documents.group_documents_user">
                    <field name="document_count" widget="statinfo" string="Documents"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
