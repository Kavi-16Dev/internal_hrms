<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Minimal quick-create form: just the Name field, so clicking
         "New" on the folder kanban pops the same lightweight
         "Add Folder" dialog shown in the reference video. -->
    <record id="documents_folder_view_form_quick_create" model="ir.ui.view">
        <field name="name">documents.folder.form.quick.create</field>
        <field name="model">documents.folder</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="e.g. Finance"/>
                </group>
            </form>
        </field>
    </record>

    <record id="documents_folder_view_kanban" model="ir.ui.view">
        <field name="name">documents.folder.kanban</field>
        <field name="model">documents.folder</field>
        <field name="arch" type="xml">
            <kanban class="o_documents_folder_kanban" quick_create="1"
                    quick_create_view="custom_documents.documents_folder_view_form_quick_create"
                    sample="1">
                <field name="name"/>
                <field name="folder_type"/>
                <field name="document_count"/>
                <field name="parent_folder_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2 d-flex align-items-center">
                            <i class="fa fa-folder fa-2x me-2 text-warning"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted small" invisible="not parent_folder_id">
                                    In <field name="parent_folder_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="documents_folder_view_list" model="ir.ui.view">
        <field name="name">documents.folder.list</field>
        <field name="model">documents.folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="folder_type"/>
                <field name="user_id" optional="show"/>
                <field name="employee_id" optional="hide"/>
                <field name="document_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="documents_folder_view_form" model="ir.ui.view">
        <field name="name">documents.folder.form</field>
        <field name="model">documents.folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="folder_type"/>
                        <field name="parent_folder_id"/>
                        <field name="user_id" invisible="folder_type != 'employee'"/>
                        <field name="employee_id" invisible="not employee_id" readonly="1"/>
                        <field name="member_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Tag Categories">
                            <field name="tag_category_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="documents_folder_view_search" model="ir.ui.view">
        <field name="name">documents.folder.search</field>
        <field name="model">documents.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Company Drive" name="company_drive" domain="[('folder_type', '=', 'company')]"/>
                <filter string="Employee Drives" name="employee_drives" domain="[('folder_type', '=', 'employee')]"/>
                <filter string="Custom Workspaces" name="custom_workspaces" domain="[('folder_type', '=', 'custom')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'folder_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="documents_folder_action" model="ir.actions.act_window">
        <field name="name">Workspaces</field>
        <field name="res_model">documents.folder</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_type': 1}</field>
    </record>

</odoo>
