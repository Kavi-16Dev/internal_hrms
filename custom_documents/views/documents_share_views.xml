<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="documents_share_view_form" model="ir.ui.view">
        <field name="name">documents.share.form</field>
        <field name="model">documents.share</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state != 'active'" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="share_type"/>
                            <field name="folder_id" invisible="share_type != 'folder'"/>
                            <field name="document_ids" widget="many2many_tags" invisible="share_type != 'ids'"/>
                            <field name="access_mode"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="date_deadline"/>
                            <field name="owner_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="full_url" widget="CopyClipboardChar" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="documents_share_view_list" model="ir.ui.view">
        <field name="name">documents.share.list</field>
        <field name="model">documents.share</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="access_mode"/>
                <field name="partner_id"/>
                <field name="date_deadline"/>
                <field name="state" widget="badge" decoration-danger="state == 'revoked'" decoration-warning="state == 'expired'" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="documents_share_action" model="ir.actions.act_window">
        <field name="name">Share Links</field>
        <field name="res_model">documents.share</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
