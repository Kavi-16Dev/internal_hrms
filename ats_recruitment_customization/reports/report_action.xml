<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_offer_letter" model="report.paperformat">
        <field name="name">Offer Letter Paperformat</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_offer_letter" model="ir.actions.report">
        <field name="name">Offer Letter</field>
        <field name="model">hr.applicant</field>
        <field name="report_type">qweb-pdf</field>

        <!-- ✅ MUST MATCH MODULE + TEMPLATE -->
        <field name="report_name">ats_recruitment_customization.report_offer_letter</field>
        <field name="report_file">ats_recruitment_customization.report_offer_letter</field>

        <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_offer_letter"/>

        <field name="print_report_name">'Offer Letter - %s' % (object.partner_name)</field>
    </record>

</odoo>